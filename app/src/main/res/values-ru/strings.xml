    <!-- Accessibility service -->
    <string name="accessibility_service_description">GestureControl использует эту службу, чтобы узнать, какое приложение на экране (жесты работают только в выбранных), показать курсор руки и выполнять нажатия, прокрутку и действия «Назад» / «Домой», которые вы вызываете рукой. Служба не читает содержимое экрана и вводимый текст и ничего не сохраняет.</string>

    <!-- Cursor and zones -->
    <string name="main_cursor_section">Курсор и зоны</string>
    <string name="main_cursor_desc">Укажите указательным пальцем, чтобы двигать курсор; сведите большой и указательный, чтобы нажать. Зоны назначают действия областям экрана каждого приложения.</string>
